{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src",
    "types": ["jest"],
    "isolatedModules": true,
    "jsx": "react-native",
    "skipLibCheck": true,
    "lib": ["ES2020"]
  },
  "include": ["src"]
}
