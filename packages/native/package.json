    "@purple-brock/burrow-core": "workspace:*",
    "@purple-brock/burrow-tokens": "workspace:*"
  },
  "devDependencies": {
    "@react-native/babel-preset": "^0.85.3",
    "@testing-library/react-native": "^12.9.0",
    "@types/jest": "^29.5.14",
    "@types/react": "^18.3.31",
    "@types/react-test-renderer": "^19.3.0",
    "babel-jest": "^30.5.2",
    "jest": "^29.7.0",
    "react": "^18.3.1",
    "react-native": "^0.74.7",
    "react-test-renderer": "^18.3.1",
    "ts-jest": "^29.4.15",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.73.0"
  },
  "license": "MIT",
