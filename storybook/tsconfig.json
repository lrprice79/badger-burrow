{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "@purple-brock/burrow-tokens": ["../packages/tokens/src/index.ts"],
      "@purple-brock/burrow-core": ["../packages/core/src/index.ts"],
      "@purple-brock/burrow-web": ["../packages/web/src/index.ts"]
    }
  },
  "include": [".storybook", "stories"]
}
